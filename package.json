{
  "name": "dsh-copilot-diff",
  "version": "0.3.0",
  "description": "Copilot-style file review for DeepSeek Harness: inline per-edit diffs, whole-file Changes sidebar, shell mutation tracking, Keep/Undo and persistent per-turn Restore Checkpoint.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "diff",
    "review",
    "undo",
    "copilot"
  ],
  "license": "MIT",
  "author": "huieric",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huieric/dsh-copilot-diff.git"
  },
  "homepage": "https://github.com/huieric/dsh-copilot-diff#readme",
  "bugs": {
    "url": "https://github.com/huieric/dsh-copilot-diff/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/diff.js",
    "lib/history.js",
    "lib/checkpoints.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js test/*.test.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
